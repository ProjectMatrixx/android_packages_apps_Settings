<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="2dp"
        android:layout_marginVertical="0dp"
        app:cardCornerRadius="10dp"
        app:cardElevation="0dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:alpha="1"
        android:src="@drawable/scrim"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:paddingHorizontal="20dp"
            android:paddingVertical="0dp"
            android:orientation="vertical"
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:layout_height="wrap_content">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:alpha="1"
            android:scaleType="centerCrop"
            android:layout_gravity="bottom"
            android:layout_marginBottom="8dp"
            android:src="@drawable/Matrixx"/>
        </LinearLayout>
    </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Version -->

    <LinearLayout
        android:id="@+id/matrixx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_weight="0">

        <RelativeLayout
            android:id="@+id/matrixx_top"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:layout_weight="1"
            android:background="@drawable/top_menu_left_top"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true">

            <TextView
                android:id="@+id/matrixx_title"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="0dp"
                android:textStyle="bold"
                android:text="@string/matrixx_title"
                android:textAlignment="center"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="35sp" />

            <TextView
                android:id="@+id/matrixx_summary"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/matrixx_title"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:textAlignment="center"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="20sp" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainatiner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:layout_weight="0">

        <RelativeLayout
            android:id="@+id/maintainer_top"
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginStart="2dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="0dp"
            android:gravity="center"
            android:layout_weight="1"
            android:background="@drawable/top_menu_left_top"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true">

            <TextView
                android:id="@+id/maintainer_title"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginTop="0dp"
                android:textStyle="bold"
                android:text="@string/mainatiner_title"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/maintainer_summary"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/maintainer_title"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="18sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Details -->

    <LinearLayout
        android:id="@+id/about_widgets2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="0dp"
        android:layout_weight="0">

        <RelativeLayout
            android:id="@+id/processor_top"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="0dp"
            android:layout_weight="1"
            android:background="@drawable/top_menu_left_bottom"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/processor_icon"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="start|center"
                android:layout_marginStart="12dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="0dp"
                android:padding="7dip"
                android:background="@drawable/icon_background"
                android:src="@drawable/ic_cpu" />

            <TextView
                android:id="@+id/processor_title"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/processor_icon"
                android:layout_marginStart="12dp"
                android:layout_marginTop="0dp"
                android:text="@string/processor_title"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/processor"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/processor_title"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="14sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/battery_top"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="2dp"
            android:layout_weight="1"
            android:background="@drawable/top_menu_right_bottom"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/battery_icon"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="start|center"
                android:layout_marginLeft="10dp"
                android:layout_marginTop="10dp"
                android:padding="7dip"
                android:background="@drawable/icon_background"
                android:src="@drawable/ic_battery" />

            <TextView
                android:id="@+id/battery_title"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/battery_icon"
                android:layout_marginStart="12dp"
                android:layout_marginTop="0dp"
                android:text="@string/battery_title"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/battery_summary"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/battery_title"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="14sp" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/about_widgets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="2dp"
        android:layout_weight="0">

        <RelativeLayout
            android:id="@+id/ram_top"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginStart="0dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="1dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            android:background="@drawable/top_menu_left_top"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/ram_image"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="start|center"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:padding="7dip"
                android:background="@drawable/icon_background"
                android:src="@drawable/ic_ram" />

            <TextView
                android:id="@+id/ram_title"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ram_image"
                android:layout_marginStart="12dp"
                android:layout_marginTop="0dp"
                android:text="@string/ram_title"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/ram"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/ram_title"
                android:layout_marginStart="12dp"
                android:layout_marginTop="4dp"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="14sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/storage_top"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginStart="1dp"
            android:layout_marginTop="0dp"
            android:layout_marginEnd="0dp"
            android:layout_marginBottom="5dp"
            android:layout_weight="1"
            android:background="@drawable/top_menu_left_bottom"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/storage_icon"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:layout_gravity="start|center"
                android:layout_marginStart="10dp"
                android:layout_marginTop="10dp"
                android:padding="7dip"
                android:background="@drawable/icon_background"
                app:tint="@android:attr/colorAccent"
                android:src="@drawable/ic_storage" />

            <TextView
                android:id="@+id/storage_title"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/storage_icon"
                android:layout_marginStart="12dp"
                android:layout_marginTop="0dp"
                android:text="@string/storage_title"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/storage"
                style="@style/op_control_text_style_h6"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/storage_title"
                android:layout_marginStart="12dp"
                android:layout_marginTop="2dp"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="14sp" />
        </RelativeLayout>
    </LinearLayout>
</LinearLayout>
