<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/logo_animation"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="4dp"
        app:lottie_rawRes="@raw/matrixx_logo_breathe"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_clipToCompositionBounds="false"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?android:attr/selectableItemBackgroundBorderless"/>

    <!-- Version -->

    <LinearLayout
        android:id="@+id/matrixx"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">

        <RelativeLayout
            android:id="@+id/matrixx_top"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:background="@drawable/top_menu_left_top"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true">

            <TextView
                android:id="@+id/matrixx_summary"
                style="@style/op_control_text_style_h6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="20sp" />
        </RelativeLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mainatiner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="2dp">

        <RelativeLayout
            android:id="@+id/maintainer_top"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:gravity="center"
            android:background="@drawable/top_menu_left_top"
            android:clickable="true"
            android:clipChildren="true"
            android:clipToOutline="true"
            android:clipToPadding="true">

            <TextView
                android:id="@+id/maintainer_summary"
                style="@style/op_control_text_style_h6"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:textAlignment="center"
                android:textColor="@color/settingslib_materialColorOnSurface"
                android:textSize="20sp" />
        </RelativeLayout>
    </LinearLayout>

    <!-- Details -->

    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/about_header_background"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/matrixx_card_side_margin"
                android:layout_marginEnd="@dimen/matrixx_card_side_margin">
                <ImageView
                    android:src="@drawable/ic_about_cpu"
                    android:layout_width="@dimen/matrixx_hw_info_icons"
                    android:layout_height="@dimen/matrixx_hw_info_icons" />
                <TextView
                    android:id="@+id/processor_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAlignment="center"
                    android:text="@string/processor_title"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
                <TextView
                    android:id="@+id/processor"
                    android:textColor="@color/settingslib_materialColorOnSurface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="center"/>
            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/matrixx_card_side_margin"
                android:layout_marginEnd="@dimen/matrixx_card_side_margin">
                <ImageView
                    android:src="@drawable/ic_about_ram"
                    android:layout_width="@dimen/matrixx_hw_info_icons"
                    android:layout_height="@dimen/matrixx_hw_info_icons" />
                <TextView
                    android:id="@+id/memory_storage_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAlignment="center"
                    android:text="@string/ram_title"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
                <TextView
                    android:id="@+id/ram"
                    android:textColor="@color/settingslib_materialColorOnSurface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="center"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginBottom="15dp">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/matrixx_card_side_margin"
                android:layout_marginEnd="@dimen/matrixx_card_side_margin">
                <ImageView
                    android:src="@drawable/ic_about_battery"
                    android:layout_width="@dimen/matrixx_hw_info_icons"
                    android:layout_height="@dimen/matrixx_hw_info_icons" />
                <TextView
                    android:id="@+id/battery_size_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAlignment="center"
                    android:text="@string/battery_title"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
                <TextView
                    android:id="@+id/battery_summary"
                    android:textColor="@color/settingslib_materialColorOnSurface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="center"/>
            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/matrixx_card_side_margin"
                android:layout_marginEnd="@dimen/matrixx_card_side_margin">
                <ImageView
                    android:src="@drawable/ic_homepage_storage"
                    android:layout_width="@dimen/matrixx_hw_info_icons"
                    android:layout_height="@dimen/matrixx_hw_info_icons" />
                <TextView
                    android:id="@+id/storage_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:textAlignment="center"
                    android:text="@string/storage_title"
                    android:textColor="@color/settingslib_materialColorOnSurface"/>
                <TextView
                    android:id="@+id/storage"
                    android:textColor="@color/settingslib_materialColorOnSurface"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAlignment="center"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
